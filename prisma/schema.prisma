// Wrestling Booker — data model.
//
// Two governing rules from the spec drive every choice here:
//   1. Enter once, derive everything. Nothing computable is stored. There are no
//      win/loss columns, no "current champion" field, no rivalry rows.
//   2. Nothing happens on its own. Every date field is inert. Contracts do not
//      expire; the app only surfaces that a date has passed.
//
// Wrestlers live at the world level. A company employs them via a Contract; it
// never owns them. That is what makes crossover native rather than a hack.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// World — the save / universe
// ---------------------------------------------------------------------------

model World {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Portraits are a feature of the world, not a hard requirement. Turning
  /// this off hides every avatar and upload control; the bytes already stored
  /// are left alone, so it is reversible.
  photosEnabled Boolean @default(true)

  wrestlers   Wrestler[]
  companies   Company[]
  contracts   Contract[]
  shows       Show[]
  groups      Group[]
  tournaments Tournament[]
}

// ---------------------------------------------------------------------------
// Wrestler — a world-level person
// ---------------------------------------------------------------------------

enum Alignment {
  FACE
  HEEL
  TWEENER
}

enum WrestlerStatus {
  ACTIVE
  RETIRED
}

/// Recorded so the roster can be filtered by division. Optional: left unset
/// rather than guessed, and never inferred from a name.
enum Gender {
  MALE
  FEMALE
  OTHER
}

model Wrestler {
  id       String         @id @default(cuid())
  worldId  String
  world    World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name     String
  nickname String?
  height   String?
  weight   String?
  align    Alignment      @default(TWEENER)
  status   WrestlerStatus @default(ACTIVE)
  gender   Gender?

  /// One portrait, stored in the database so it is covered by the same backups
  /// as the rest of the world. Bytes live in WrestlerPhoto so they never ride
  /// along on ordinary roster queries.
  photo WrestlerPhoto?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts   Contract[]
  appearances SegmentParticipant[]
  reigns      Reign[]              @relation("ReignHolders")
  groups      Group[]              @relation("GroupMembers")
  tournaments TournamentEntrant[]

  @@index([worldId, name])
}

/// A tag team, trio or faction — one model, because they differ only in size.
/// Which one a unit *is* is never stored: it falls out of the member count, so
/// a faction that loses a member becomes a trio without anyone editing a field.
/// Membership is a plain many-to-many, so a wrestler can hold a tag team, a
/// trio and a faction at once.
model Group {
  id      String @id @default(cuid())
  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  name  String
  /// Tints the unit wherever it is listed, same idea as a company's colour.
  color String?
  notes String?

  /// Disbanded units stay in the world; the matches they worked are still
  /// readable. Nothing expires on its own — you disband it by hand.
  isActive Boolean @default(true)

  /// Hand-sorted rather than alphabetical. Set by dragging.
  order Int @default(0)

  members     Wrestler[]          @relation("GroupMembers")
  tournaments TournamentEntrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId, name])
}

model WrestlerPhoto {
  wrestlerId String   @id
  wrestler   Wrestler @relation(fields: [wrestlerId], references: [id], onDelete: Cascade)
  mimeType   String
  bytes      Bytes
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Company — a promotion
// ---------------------------------------------------------------------------

model Company {
  id           String  @id @default(cuid())
  worldId      String
  world        World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String?
  /// Tailwind-ish accent used to tint the company on the calendar.
  color        String?
  notes        String?
  /// Hand-sorted rather than alphabetical.
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles      Title[]
  series      WeeklySeries[]
  contracts   Contract[]
  tournaments Tournament[]
  /// A show may be co-promoted, so this is many-to-many in both directions.
  shows       Show[]         @relation("ShowCompanies")

  @@index([worldId, name])
}

// ---------------------------------------------------------------------------
// Contract — one wrestler <-> one company
// ---------------------------------------------------------------------------

model Contract {
  id         String   @id @default(cuid())
  worldId    String
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  wrestlerId String
  wrestler   Wrestler @relation(fields: [wrestlerId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Is this the wrestler's home roster? At most one primary per wrestler.
  isPrimary Boolean @default(false)

  signedOn  DateTime? @db.Date
  /// Inert. Nothing expires on its own; a passed date is only ever surfaced.
  expiresOn DateTime? @db.Date
  salary    String?
  notes     String?

  /// Set when you choose "leave as free agent". Keeps the deal as history
  /// instead of deleting it.
  endedOn DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wrestlerId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Title — a spine of reigns
// ---------------------------------------------------------------------------

model Title {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  /// Retired belts stay in the world; their lineage is still readable.
  isActive  Boolean @default(true)

  /// 1 = singles, 2 = tag team, 3 = trios. A count rather than an enum, so a
  /// belt for a four-person unit needs no new case — the same shape as a
  /// unit's kind. Nothing enforces it at play time: a belt can be won short-
  /// handed, and the tool records what happened rather than what should have.
  holderCount Int     @default(1)
  notes       String?
  /// Hand-sorted: world title first, then secondary, then tag. Set by dragging.
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reigns   Reign[]
  defences Segment[]

  @@index([companyId])
}

/// Never typed by hand. Reigns are opened and closed by *playing* a title match.
/// The current champion is simply the most recent reign with no endedOn.
model Reign {
  id      String @id @default(cuid())
  titleId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  /// Usually one wrestler; a set for tag/trios belts.
  holders Wrestler[] @relation("ReignHolders")

  startedOn      DateTime @db.Date
  wonAtShowId    String?
  wonAtShow      Show?    @relation("ReignWonAt", fields: [wonAtShowId], references: [id], onDelete: SetNull)
  wonAtSegmentId String?

  endedOn         DateTime? @db.Date
  lostAtShowId    String?
  lostAtShow      Show?     @relation("ReignLostAt", fields: [lostAtShowId], references: [id], onDelete: SetNull)
  lostAtSegmentId String?

  createdAt DateTime @default(now())

  @@index([titleId, startedOn])
}

// ---------------------------------------------------------------------------
// Schedule — weekly series produce episodes; specials stand alone
// ---------------------------------------------------------------------------

enum Cadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Defined once. The calendar projects its future slots without storing them;
/// a slot only becomes a Show row when you start booking it.
model WeeklySeries {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  cadence   Cadence   @default(WEEKLY)
  /// Tints every entry for this series on the calendar.
  color     String?
  /// Anchor date. Day-of-week and every future slot are derived from this.
  startsOn  DateTime  @db.Date
  /// Set to stop projecting future episodes. Past episodes remain.
  endedOn   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shows Show[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Show — the card
// ---------------------------------------------------------------------------

model Show {
  id      String @id @default(cuid())
  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  name String
  date DateTime @db.Date

  /// Set for an episode of a weekly series; null for a standalone special.
  seriesId String?
  series   WeeklySeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  /// One or more owning companies (joint / co-promoted events).
  companies Company[] @relation("ShowCompanies")

  venue String?
  notes String?
  /// Overrides the series (and company) colour on the calendar.
  color String?

  /// The one-way door. Set by *playing* the show; the boundary between an
  /// editable plan and immutable history.
  isFinalized Boolean   @default(false)
  playedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments   Segment[]
  reignsWon  Reign[]   @relation("ReignWonAt")
  reignsLost Reign[]   @relation("ReignLostAt")

  @@index([worldId, date])
  @@index([seriesId, date])
}

// ---------------------------------------------------------------------------
// Segment — the card unit. A match is a segment whose type is MATCH.
// ---------------------------------------------------------------------------

enum SegmentType {
  MATCH
  PROMO
  BACKSTAGE
  CONTRACT_SIGNING
  VIDEO_PACKAGE
  BRAWL
  INTERVIEW
  ANGLE
  OTHER
}

model Segment {
  id     String @id @default(cuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  /// Position on the card.
  order Int

  type       SegmentType @default(MATCH)
  /// The escape hatch: free text used when type is OTHER.
  customType String?

  /// What this was *about* / booking intent. Written while booking.
  note String?

  // --- match-only result payload -------------------------------------------

  /// Firing this is what creates and closes reigns when the show is played.
  isTitleMatch Boolean @default(false)
  titleId      String?
  title        Title?  @relation(fields: [titleId], references: [id], onDelete: SetNull)

  /// Pick-list with a freeform escape hatch. Blank for a standard match.
  stipulation String?

  // --- tournament placement -------------------------------------------------

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  /// A league's playoff match rather than a block match: a semi-final win must
  /// not inflate the block table. The round *number* is never stored — it is
  /// counted from the matches already booked (see `roundsOf`), so a bracket
  /// renumbers itself as it is filled in and a bye costs nobody a round.
  isPlayoff Boolean @default(false)

  /// How it *finished*. Written while playing, distinct from `note`.
  resultNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants SegmentParticipant[]

  @@index([showId, order])
  @@index([tournamentId])
}

/// The winner is the single most important input in the tool: it is what
/// ripples upstream into records, reigns and head-to-heads. It is only ever
/// set during Play, never during Booking.
model SegmentParticipant {
  id         String   @id @default(cuid())
  segmentId  String
  segment    Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  wrestlerId String
  wrestler   Wrestler @relation(fields: [wrestlerId], references: [id], onDelete: Cascade)

  order    Int
  isWinner Boolean @default(false)

  @@unique([segmentId, wrestlerId])
  @@index([wrestlerId])
}

// ---------------------------------------------------------------------------
// Tournaments — a league or a bracket, laid over ordinary matches
// ---------------------------------------------------------------------------

/// What happens after a league's block matches are done.
enum PlayoffFormat {
  /// The table decides it outright.
  NONE
  /// One match: whoever tops each block.
  BLOCK_WINNERS
  /// Semi-finals from the top two of every block.
  TOP_TWO_PER_BLOCK
  /// A bracket of the best four across all blocks.
  TOP_FOUR_OVERALL
  /// A bracket of the best eight across all blocks.
  TOP_EIGHT_OVERALL
}

enum TournamentFormat {
  /// Everyone in a block meets everyone else; points decide it.
  ROUND_ROBIN
  /// Lose and you are out.
  SINGLE_ELIMINATION
}

/// A tournament stores who is in it and how it is scored, and nothing else.
/// Standings, points, the bracket and who has advanced are all derived from
/// the matches themselves — see src/lib/derive.ts. A tournament match is an
/// ordinary segment that points back here, so it counts towards records and
/// title reigns exactly like any other match.
model Tournament {
  id      String @id @default(cuid())
  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  /// Optional: a tournament can be co-promoted or belong to nobody.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  name   String
  format TournamentFormat @default(ROUND_ROBIN)
  color  String?
  notes  String?

  /// League scoring. Two for a win and one for a draw is the usual ruleset and
  /// the default here; it is editable because not every league agrees.
  pointsWin  Int @default(2)
  pointsDraw Int @default(1)

  /// How many blocks the field is split into. Entrants are assigned by hand —
  /// nothing here draws the blocks for you.
  blockCount Int @default(1)

  /// How a league is settled once the blocks are done. Who qualifies falls out
  /// of the table; the matches themselves are still yours to book.
  playoff PlayoffFormat @default(NONE)

  /// No dates: a tournament happens on the shows its matches are booked on,
  /// so when it ran is read off those shows rather than typed in twice.

  /// Marked finished by hand. Nothing concludes on its own, and a finished
  /// tournament keeps its standings.
  isComplete Boolean @default(false)

  entrants TournamentEntrant[]
  segments Segment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId, name])
}

/// One place in the field: a wrestler or a unit, never both. Units are how a
/// tag league works — the entrant is the team, and a team's match is one where
/// every member is on the same side.
model TournamentEntrant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  wrestlerId String?
  wrestler   Wrestler? @relation(fields: [wrestlerId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// "A", "B" … matching the tournament's block count. Null means unassigned.
  block String?

  order Int @default(0)

  @@index([tournamentId])
}
