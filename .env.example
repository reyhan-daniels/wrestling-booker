# Local dev database (user-owned Postgres cluster at ~/.local/share/wb-pgdata, port 55432)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Single shared password gate. Change this before deploying.
APP_PASSWORD="set-a-strong-password"
# Secret used to sign the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
